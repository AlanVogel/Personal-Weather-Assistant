# Environment: development | staging | production
ENVIRONMENT=development
DEBUG=false

# External API credentials (get free keys from openweathermap.org and console.groq.com)
OPENWEATHER_API_KEY=your_openweather_key_here
GROQ_API_KEY=your_groq_key_here

# LLM configuration
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1500
LLM_TIMEOUT_SECONDS=30

# Weather API configuration
WEATHER_TIMEOUT_SECONDS=10
WEATHER_UNITS=metric

# Cache configuration (seconds; 0 disables caching)
CACHE_TTL_SECONDS=600

# Concurrency limits
MAX_CONCURRENT_LLM_CALLS=10
MAX_CONCURRENT_WEATHER_CALLS=20

# Per-IP rate limiting on the LLM endpoints (slowapi syntax, e.g. "20/minute")
RATE_LIMIT_ENABLED=true
RATE_LIMIT=20/minute

# CORS (comma-separated list of allowed origins)
# In production set this to your Vercel domain, e.g. https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
